                hb = refs[1][0]
                tri = tuple(i for _, i in refs[1:])
                gi = next((k for k, f in enumerate(blocks[hb].faces) if set(tri) <= set(f)), None)
                if gi is None:
                    n = len(blocks[hb].verts)
                    x, y, z = sorted(tri)
                    gi = -1-x*n*n-y*n-z
                    violations.append(("legacy triangle not on exact hull face", hb, tri))
