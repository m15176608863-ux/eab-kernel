            all_covers = []
            for label, strict in cover_labels(A, B, tol):
                gap, normal = construction(A, B, label, tol)
                if construction(A, B, label, tol, distance_squared=True) <= Fraction(max(window, band))**2:
                    all_covers.append((label, strict, gap, normal))
