+    FA = [(Fraction(a) + X[0], Fraction(b) + X[1]) for a, b in A]
+    FB = [(Fraction(a), Fraction(b)) for a, b in B]
+    gaps = []
+    for P, Q in ((FA, FB), (FB, FA)):
