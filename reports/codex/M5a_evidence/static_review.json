        "closed-rounded-construction",
        "rounded-root"
      ],
      "result": "EXPECTED_RED"
    },
    {
      "name": "direct_norm",
      "source": "def bad(compare):\n    return norm_rational((scalar_algebraic(compare), 1))\n",
      "expected_semantic_rule": "rounded-vector",
      "observed_rules": [
        "closed-rounded-construction",
        "rounded-vector"
      ],
      "result": "EXPECTED_RED"
    },
    {
      "name": "direct_unit",
      "source": "def bad(compare):\n    return unit_rational((scalar_algebraic(compare), 1))\n",
      "expected_semantic_rule": "rounded-vector",
      "observed_rules": [
        "closed-rounded-construction",
        "rounded-vector"
      ],
      "result": "EXPECTED_RED"
    },
    {
      "name": "fraction_wrap",
