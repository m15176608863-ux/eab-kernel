            "150: // df07 接触长度 o5(proj 累积语义)",
            "151: template <Scalar S>",
            "152: inline S df07_o5(const Tuple7& t7, const VertexStore<S>& vs, double w0) {",
            "153:     const int mt = t7[0], p1i = t7[1], p2i = t7[2], p3i = t7[3];",
            "154:     const int m4 = t7[4], m5 = t7[5], m6 = t7[6];",
            "155:     if (mt != 0) return S(0.0);",
            "156:     std::vector<int> calls;",
            "157:     if (m6 > 0) { calls.push_back(m5); calls.push_back(m6); }",
            "158:     else {",
            "159:         if (m4 > 0) calls.push_back(m4);",
            "160:         if (m5 > 0) calls.push_back(m5);",
            "161:     }",
            "162:     if (calls.empty()) return S(0.0);",
            "163:     const Pt<S> P1 = vs.p(p1i), P2 = vs.p(p2i), P3 = vs.p(p3i);",
            "164:     const S ex = P3[0] - P2[0], ey = P3[1] - P2[1];",
            "165:     const S d1 = ex * ex + ey * ey + S(1e-9 * w0);",
            "166:     const S s1 = ((P1[0] - P2[0]) * ex + (P1[1] - P2[1]) * ey) / d1;",
            "167:     S o5(0.0);",
            "168:     for (int i4 : calls) {",
            "169:         const Pt<S> P4 = vs.p(i4);",
            "170:         const S s4 = ((P4[0] - P2[0]) * ex + (P4[1] - P2[1]) * ey) / d1;",
            "171:         std::array<S, 4> s = {s1, S(0.0), S(1.0), s4};",
            "172:         // 排序按 primal(离散重排;导数随值搬运)——与一代 std::sort 同序",
            "173:         std::sort(s.begin(), s.end(),",
            "174:                   [](const S& a, const S& b) { return val(a) < val(b); });"
          ]
        }
