      "path": "src/eab/kernel2d/se2_cage.py",
      "name": "verify_se2_cage",
      "kind": "FunctionDef",
      "line": 965,
      "internal": false,
      "docstring": "Check an independently supplied instance against an untrusted cage.\n\nIn-memory exact integers/Fractions are accepted; JSON rational fields must\nbe canonical strings.  Invalid certificates return their first condition\nin V0, CHAIN, V1, ..., V6 order.  No rejected proposal proves an escape.",
      "parameters": "instance, certificate"
    },
