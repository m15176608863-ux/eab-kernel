    },
    {
      "check": "root_arithmetic_order",
      "status": "PASS",
      "detail": "Integer-discriminant quadratic formula reduces perfect squares to Fraction. Irrational Root key (h, sign(k), k^2*d) is canonical for its h+k*sqrt(d) algebraic number; dyadic separators sort distinct unit roots exactly. evaluate_sign reduces degree-two expressions in Q(sqrt(d))."
    },
    {
      "check": "body_state_partition",
      "status": "PASS",
      "detail": "Each event interval has two strict rational interior samples checked by independent g0 overlap. Full supporting-line/collinear-endpoint superset certifies state cannot change between sampled roots. All intervals before the first incidence must be separated."
    },
    {
      "check": "complete_incidences_covers",
      "status": "PASS",
      "detail": "All VE, EV, VV labels are enumerated. On-segment uses axis boxes rather than production dot products. Covers use convexity plus both neighboring vertices in opposing edge half-planes; valid flat vertices require opposite edge orientation. Complete sets are compared, not a representative."
    },
    {
      "check": "domain_valid_by_construction",
      "status": "PASS",
      "detail": "Each random ring uses the same affine end map for its vertices. At s in [0,1], diagonal entries >=7/8 and off-diagonals <=1/8, so determinant >=3/4>0; initial CCW/simple rings, including concave L, remain valid. Fifteen structured probes are likewise valid."
    },
    {
      "check": "requested_coverage",
      "status": "PASS",
      "detail": "Observed counters below prove concave rings, irrational first times and multiple tied features; 108 random cases truly deform rather than translate."
    }
